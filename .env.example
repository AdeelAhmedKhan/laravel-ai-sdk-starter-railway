# Laravel AI SDK starter — PLACEHOLDERS ONLY. Never put a real key,
# password or token in this file. Copy to .env and fill in real values.
#
# --- App ----------------------------------------------------------------
APP_NAME="Laravel AI SDK Starter"
APP_ENV=production
APP_KEY=
# Generate with: php artisan key:generate --show
# The app REFUSES to boot in production without APP_KEY (see
# docker/entrypoint.sh). Never commit a real APP_KEY.
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app
APP_TIMEZONE=UTC

# --- Database -----------------------------------------------------------
# Locally (parity testing only): SQLite at database/database.sqlite.
# The Postgres path is implemented but NOT live-tested locally — see README.
DB_CONNECTION=sqlite
# On Railway: set BOTH of these on the app service —
#   DB_CONNECTION=pgsql
#   DATABASE_URL=${{Postgres.DATABASE_URL}}   (reference variable to the
#   Postgres service; Railway fills in the real connection string)
# Laravel reads DB_URL by default; config/database.php also accepts
# DATABASE_URL, so the Railway reference variable works as-is.
DATABASE_URL=

# --- Sessions / cache / queue -------------------------------------------
# Secure cookie defaults are enforced in config/session.php and
# docker/php/security.ini (secure, http_only, same_site=lax).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- AI providers (ALL OPTIONAL) ----------------------------------------
# The demo endpoint works without any of these: it reports
# configured: false and tells the caller which variable to set.
# Set ONE to make the demo call a real provider. The first key
# found in this order wins: OpenAI, Anthropic, Gemini, DeepSeek,
# Groq, xAI, Mistral, OpenRouter. Full list lives in config/ai.php.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Mail (optional) ----------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Logging ------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=warning
